dx := `which -a dx | grep dioxus | head -1`

# DWARF is not worth its weight in a shipped web bundle.
release := "--release --debug-symbols false"

# Frontend-only hot reload; use `just run` for the full stack.
dev:
    {{dx}} serve

build:
    {{dx}} build {{release}}

# Build the bundle, then serve it from the native host.
run: build
    WEBXR_COMPOSITOR_WEB_ROOT=target/dx/webxr-compositor/release/web/public \
        cargo run --release --manifest-path host/Cargo.toml

# Both workspaces: the frontend one and the host's own.
test:
    cargo test --workspace
    cargo test --workspace --manifest-path host/Cargo.toml

# Run the built bundle against the real host in headless chromium and check
# the hello exchange completes. Needs `just build` first.
browser *args:
    cargo build --manifest-path host/Cargo.toml
    nu test-browser.nu {{args}}

# Start the host and check the Wayland globals it advertises.
wayland *args:
    cargo build --manifest-path host/Cargo.toml
    nu test-wayland.nu {{args}}

# Run the checker client against the host and check its pixels reach and
# animate on the browser canvas. Needs `just build` first.
surface *args:
    cargo build --manifest-path host/Cargo.toml --example checker
    cargo build --manifest-path host/Cargo.toml
    nu test-surface.nu {{args}}

# Type into a real terminal (foot) through the page and check the echo.
# Needs `just build` first.
input *args:
    cargo build --manifest-path host/Cargo.toml
    nu test-input.nu {{args}}

# Drive drag, focus, raise, resize, close and reload-resync with two
# clients side by side. Needs `just build` first.
windows *args:
    cargo build --manifest-path host/Cargo.toml --example checker
    cargo build --manifest-path host/Cargo.toml
    nu test-windows.nu {{args}}

# Check that typing into foot ships small damage rects, not full frames.
# Needs `just build` first.
damage *args:
    cargo build --manifest-path host/Cargo.toml
    nu test-damage.nu {{args}}

# Clipboard both ways plus cursor-shape, against foot. Needs `just build`
# first.
clipboard *args:
    cargo build --manifest-path host/Cargo.toml
    nu test-clipboard.nu {{args}}

# A real GTK4 app (gnome-calculator): window, menus, dismissal. Needs
# `just build` first.
gtk *args:
    cargo build --manifest-path host/Cargo.toml
    nu test-gtk.nu {{args}}

# The end goal: Zed (software Vulkan) editing in the browser. Needs
# `just build` first and zeditor on PATH.
zed *args:
    cargo build --manifest-path host/Cargo.toml
    nu test-zed.nu {{args}}

# The 3D scene: window textures on the arc, sampled off the WebGL canvas.
# Needs `just build` first.
xr *args:
    cargo build --manifest-path host/Cargo.toml --example checker
    cargo build --manifest-path host/Cargo.toml
    nu test-xr.nu {{args}}

# The secure transport: wss with a token, wrong tokens refused. Needs
# `just build` first.
tls *args:
    cargo build --manifest-path host/Cargo.toml
    nu test-tls.nu {{args}}

# Sustained motion must stream as H.264 through WebCodecs. Needs
# `just build` first.
video *args:
    cargo build --manifest-path host/Cargo.toml --example checker
    cargo build --manifest-path host/Cargo.toml
    nu test-video.nu {{args}}

# Hardware GL clients through dmabuf readback (skips without a GPU).
# Needs `just build` first.
gpu *args:
    cargo build --manifest-path host/Cargo.toml
    nu test-gpu.nu {{args}}

lint:
    cargo clippy --workspace --all-targets -- -D warnings
    cargo clippy --workspace --all-targets --manifest-path host/Cargo.toml -- -D warnings

clean:
    {{dx}} clean
    cargo clean --manifest-path host/Cargo.toml
