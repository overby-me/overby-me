{
	"lexicon": 1,
	"id": "com.example.wiki.listContexts",
	"defs": {
		"main": {
			"type": "query",
			"description": "Contexts, by name. `roots` (the default): those at the top of the tree that the caller may read. `mine`: the groups and events the caller has a seat in and has said yes to, wherever they sit, which is what a home screen lists. `public`: every place open to everyone, at any depth, less the site itself.",
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["contexts"],
					"properties": {
						"contexts": {
							"type": "array",
							"items": {
								"type": "ref",
								"ref": "com.example.wiki.defs#contextView"
							}
						}
					}
				}
			},
			"parameters": {
				"type": "params",
				"properties": {
					"scope": {
						"type": "string",
						"enum": ["roots", "mine", "public"],
						"default": "roots"
					},
					"kind": {
						"type": "string",
						"enum": ["group", "event"],
						"description": "With `mine`: one of the two."
					}
				}
			},
			"errors": [
				{
					"name": "InvalidRequest",
					"description": "No such scope."
				}
			]
		}
	}
}
