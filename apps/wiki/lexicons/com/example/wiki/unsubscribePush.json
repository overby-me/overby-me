{
	"lexicon": 1,
	"id": "com.example.wiki.unsubscribePush",
	"defs": {
		"main": {
			"type": "procedure",
			"description": "This device stops ringing. Any signed-in caller may drop an endpoint they know, since knowing it is holding the device: that is how signing out on a shared phone has to work.",
			"input": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["endpoint"],
					"properties": {
						"endpoint": {
							"type": "string"
						}
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["ok"],
					"properties": {
						"ok": {
							"type": "boolean"
						}
					}
				}
			},
			"errors": [
				{
					"name": "AuthRequired",
					"description": "The caller is not authenticated."
				}
			]
		}
	}
}
