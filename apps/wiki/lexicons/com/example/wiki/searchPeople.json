{
	"lexicon": 1,
	"id": "com.example.wiki.searchPeople",
	"defs": {
		"main": {
			"type": "query",
			"description": "The people whose name or handle contains the query, whatever its case, for the pickers that invite someone or credit an author. Ten at most, and nothing for fewer than two letters. With `contexts`, also the groups and events by that name that the caller may read, since a group can be an author.",
			"parameters": {
				"type": "params",
				"required": ["q"],
				"properties": {
					"q": {
						"type": "string"
					},
					"contexts": {
						"type": "boolean",
						"default": false
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["people", "contexts"],
					"properties": {
						"people": {
							"type": "array",
							"maxLength": 10,
							"items": {
								"type": "ref",
								"ref": "com.example.wiki.defs#userView"
							}
						},
						"contexts": {
							"type": "array",
							"maxLength": 10,
							"items": {
								"type": "ref",
								"ref": "com.example.wiki.defs#nodeRef"
							}
						}
					}
				}
			},
			"errors": [
				{
					"name": "AuthRequired",
					"description": "The caller is not authenticated."
				}
			]
		}
	}
}
