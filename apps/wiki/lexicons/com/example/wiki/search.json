{
	"lexicon": 1,
	"id": "com.example.wiki.search",
	"defs": {
		"main": {
			"type": "query",
			"description": "Search documents by a title/content substring. Serves only what the caller may read.",
			"parameters": {
				"type": "params",
				"required": ["q"],
				"properties": {
					"q": { "type": "string", "description": "The search substring." }
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["documents"],
					"properties": {
						"documents": {
							"type": "array",
							"items": {
								"type": "ref",
								"ref": "com.example.wiki.defs#documentView"
							}
						}
					}
				}
			}
		}
	}
}
