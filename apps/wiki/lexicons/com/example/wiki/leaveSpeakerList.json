{
	"lexicon": 1,
	"id": "com.example.wiki.leaveSpeakerList",
	"defs": {
		"main": {
			"type": "procedure",
			"description": "Withdraw from a queue, or be removed from it by an owner.",
			"input": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["entry_id"],
					"properties": {
						"entry_id": {
							"type": "string"
						}
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["ok"],
					"properties": {
						"ok": {
							"type": "boolean"
						}
					}
				}
			},
			"errors": [
				{
					"name": "AuthRequired",
					"description": "The caller is not authenticated."
				},
				{
					"name": "NotFound",
					"description": "No such entry, or one in a context the caller is not a member of."
				},
				{
					"name": "Forbidden",
					"description": "The entry is someone else's and the caller is not an owner."
				}
			]
		}
	}
}
