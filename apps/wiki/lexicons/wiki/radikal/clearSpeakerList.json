{
	"lexicon": 1,
	"id": "wiki.radikal.clearSpeakerList",
	"defs": {
		"main": {
			"type": "procedure",
			"description": "An owner empties a list's queue.",
			"input": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["list_id"],
					"properties": {
						"list_id": {
							"type": "string"
						}
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["cleared"],
					"properties": {
						"cleared": {
							"type": "integer"
						}
					}
				}
			},
			"errors": [
				{
					"name": "AuthRequired",
					"description": "The caller is not authenticated."
				},
				{
					"name": "NotFound",
					"description": "No such speaker list, or one in a context the caller is not a member of."
				},
				{
					"name": "Forbidden",
					"description": "The caller is not an owner of the context."
				}
			]
		}
	}
}
