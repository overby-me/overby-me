{
	"lexicon": 1,
	"id": "wiki.radikal.createSpeakerList",
	"defs": {
		"main": {
			"type": "procedure",
			"description": "An owner of a context makes a speaker list in it. A context may hold several.",
			"input": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["context_id", "name"],
					"properties": {
						"context_id": {
							"type": "string"
						},
						"name": {
							"type": "string"
						}
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["id"],
					"properties": {
						"id": {
							"type": "string"
						}
					}
				}
			},
			"errors": [
				{
					"name": "AuthRequired",
					"description": "The caller is not authenticated."
				},
				{
					"name": "NotFound",
					"description": "No such context, or none the caller may read."
				},
				{
					"name": "Forbidden",
					"description": "The caller is not an owner of the context."
				},
				{
					"name": "InvalidRequest",
					"description": "The name is empty."
				}
			]
		}
	}
}
