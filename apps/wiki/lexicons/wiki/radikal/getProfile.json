{
	"lexicon": 1,
	"id": "wiki.radikal.getProfile",
	"defs": {
		"main": {
			"type": "query",
			"description": "Who a DID is, for a profile page. For the signed in only: a DID known here is someone who has signed in here or been named here, which a stranger is not told.",
			"parameters": {
				"type": "params",
				"required": ["did"],
				"properties": {
					"did": {
						"type": "string",
						"format": "did"
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "ref",
					"ref": "wiki.radikal.defs#userView"
				}
			},
			"errors": [
				{
					"name": "AuthRequired",
					"description": "The caller is not authenticated."
				},
				{
					"name": "NotFound",
					"description": "Nobody by that DID here."
				}
			]
		}
	}
}
