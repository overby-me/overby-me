{
	"lexicon": 1,
	"id": "wiki.radikal.acceptInvitation",
	"defs": {
		"main": {
			"type": "procedure",
			"description": "Say yes to an invitation made out to the caller's account. Declining is removeMember on the same row.",
			"input": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["id"],
					"properties": {
						"id": {
							"type": "string"
						}
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["ok"],
					"properties": {
						"ok": {
							"type": "boolean"
						}
					}
				}
			},
			"errors": [
				{
					"name": "AuthRequired",
					"description": "The caller is not authenticated."
				},
				{
					"name": "NotFound",
					"description": "No invitation by that id is made out to the caller."
				}
			]
		}
	}
}
