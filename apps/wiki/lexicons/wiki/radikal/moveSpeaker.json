{
	"lexicon": 1,
	"id": "wiki.radikal.moveSpeaker",
	"defs": {
		"main": {
			"type": "procedure",
			"description": "The chair puts a speaker ahead of the whole queue or behind it. The override outranks the kind of contribution.",
			"input": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["entry_id", "to"],
					"properties": {
						"entry_id": {
							"type": "string"
						},
						"to": {
							"type": "string",
							"enum": ["front", "back"]
						}
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["ok"],
					"properties": {
						"ok": {
							"type": "boolean"
						}
					}
				}
			},
			"errors": [
				{
					"name": "AuthRequired",
					"description": "The caller is not authenticated."
				},
				{
					"name": "NotFound",
					"description": "No such entry, or one in a context the caller is not a member of."
				},
				{
					"name": "Forbidden",
					"description": "The caller is not an owner of the context."
				},
				{
					"name": "InvalidRequest",
					"description": "`to` is neither `front` nor `back`."
				}
			]
		}
	}
}
