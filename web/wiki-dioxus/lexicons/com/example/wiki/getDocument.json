{
  "lexicon": 1,
  "id": "com.example.wiki.getDocument",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch a content node (document / folder / file / proposal) by id, with its authors. Identity-free (public content lookup).",
      "parameters": {
        "type": "params",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "The document id." }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "ref", "ref": "com.example.wiki.defs#documentView" }
      },
      "errors": [
        { "name": "NotFound", "description": "No document has that id." }
      ]
    }
  }
}
