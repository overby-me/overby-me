{
  "lexicon": 1,
  "id": "com.example.wiki.removeReaction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remove the caller's emoji reaction from a subject (the toggle-off). Idempotent: removing an absent reaction succeeds. Requires authentication; the caller's DID is the reactor.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subject", "emoji"],
          "properties": {
            "subject": {
              "type": "string",
              "format": "at-uri",
              "description": "The at-uri of the record being un-reacted."
            },
            "emoji": {
              "type": "string",
              "maxGraphemes": 1,
              "maxLength": 64,
              "description": "The emoji grapheme to remove."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean", "const": true }
          }
        }
      },
      "errors": [
        { "name": "AuthRequired", "description": "The caller is not authenticated." }
      ]
    }
  }
}
