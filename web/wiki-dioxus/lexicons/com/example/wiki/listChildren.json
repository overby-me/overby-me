{
  "lexicon": 1,
  "id": "com.example.wiki.listChildren",
  "defs": {
    "main": {
      "type": "query",
      "description": "List the child documents directly under a node. Identity-free.",
      "parameters": {
        "type": "params",
        "required": ["parent"],
        "properties": {
          "parent": { "type": "string", "description": "The parent node id." }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["documents"],
          "properties": {
            "documents": {
              "type": "array",
              "items": { "type": "ref", "ref": "com.example.wiki.defs#documentView" }
            }
          }
        }
      }
    }
  }
}
