{
  "lexicon": 1,
  "id": "com.example.wiki.getComments",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch the comment thread on a node (document or comment). Identity-free.",
      "parameters": {
        "type": "params",
        "required": ["on"],
        "properties": {
          "on": {
            "type": "string",
            "description": "The id of the node the comments hang on."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["comments"],
          "properties": {
            "comments": {
              "type": "array",
              "items": { "type": "ref", "ref": "com.example.wiki.defs#commentView" }
            }
          }
        }
      }
    }
  }
}
