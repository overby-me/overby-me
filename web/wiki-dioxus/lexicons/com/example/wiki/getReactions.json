{
  "lexicon": 1,
  "id": "com.example.wiki.getReactions",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch the emoji reactions on a subject, addressed by the subject's at-uri. Identity-free.",
      "parameters": {
        "type": "params",
        "required": ["subject"],
        "properties": {
          "subject": {
            "type": "string",
            "format": "at-uri",
            "description": "The at-uri of the reacted-to record."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["reactions"],
          "properties": {
            "reactions": {
              "type": "array",
              "items": { "type": "ref", "ref": "com.example.wiki.defs#reactionView" }
            }
          }
        }
      }
    }
  }
}
