{
  "lexicon": 1,
  "id": "com.example.wiki.postComment",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Post a comment on a node (document or comment). Requires authentication; the caller's DID is the comment's author, taken from the request's authorization.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["on_id", "context_id", "text"],
          "properties": {
            "on_id": {
              "type": "string",
              "description": "The node the comment replies to."
            },
            "context_id": { "type": "string" },
            "text": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "description": "The new comment's id." }
          }
        }
      },
      "errors": [
        { "name": "AuthRequired", "description": "The caller is not authenticated." }
      ]
    }
  }
}
