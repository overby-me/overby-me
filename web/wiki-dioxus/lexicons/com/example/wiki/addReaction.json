{
  "lexicon": 1,
  "id": "com.example.wiki.addReaction",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Add an emoji reaction to a subject. Idempotent: re-adding the same (caller, subject, emoji) is a no-op. Requires authentication; the caller's DID is the reactor.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subject", "emoji"],
          "properties": {
            "subject": {
              "type": "string",
              "format": "at-uri",
              "description": "The at-uri of the record being reacted to."
            },
            "emoji": {
              "type": "string",
              "maxGraphemes": 1,
              "maxLength": 64,
              "description": "A single emoji grapheme cluster."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "description": "The reaction's id (stable across idempotent re-adds)."
            }
          }
        }
      },
      "errors": [
        { "name": "AuthRequired", "description": "The caller is not authenticated." }
      ]
    }
  }
}
