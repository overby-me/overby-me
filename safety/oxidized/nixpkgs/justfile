# Show component status (available, planned, etc.)
status:
    nix build .#oxidized-nixpkgs-test --no-link --print-build-logs

# Build the test derivation (verifies all components are available)
test:
    nix build .#oxidized-nixpkgs-test

# Build with the Rust stdenv (verifies stdenv override works end-to-end)
test-stdenv:
    nix build .#oxidized-nixpkgs-stdenv-test --no-link --print-build-logs

# Explore the stdenvRs closure
tree:
    nix-tree .#oxidized-nixpkgs-test

# Run all package build tests
test-all:
    #!/usr/bin/env bash
    set -e
    tests=(oxidized-nixpkgs-test oxidized-nixpkgs-stdenv-test oxidized-nixpkgs-hello-test oxidized-nixpkgs-zlib-test oxidized-nixpkgs-gnupatch-test oxidized-nixpkgs-coreutils-test oxidized-nixpkgs-gnugrep-test oxidized-nixpkgs-gnused-test oxidized-nixpkgs-gnudiffutils-test oxidized-nixpkgs-gnumake-test oxidized-nixpkgs-gnuawk-test oxidized-nixpkgs-bc-test oxidized-nixpkgs-gnutar-test oxidized-nixpkgs-gnugzip-test oxidized-nixpkgs-xz-test oxidized-nixpkgs-gnufindutils-test oxidized-nixpkgs-readline-test oxidized-nixpkgs-libffi-test oxidized-nixpkgs-pcre2-test oxidized-nixpkgs-m4-test oxidized-nixpkgs-libtool-test oxidized-nixpkgs-bzip2-test)
    for test in "${tests[@]}"; do
        echo -n "$test: "
        if nix build ".#$test" --no-link 2>/dev/null; then
            echo "PASS"
        else
            echo "FAIL"
        fi
    done

# List all component files
components:
    @echo "=== Component Registry ==="
    @for f in components/*.nix; do \
        [ "$(basename "$f")" = "default.nix" ] && continue; \
        name="$(basename "$f" .nix)"; \
        if grep -q 'status.available' "$f"; then \
            echo "  ✅ $name"; \
        elif grep -q 'status.inProgress' "$f"; then \
            echo "  🔧 $name"; \
        else \
            echo "  ⏳ $name"; \
        fi; \
    done
