# Subprojects published from this monorepo as standalone Tangled repos.
#
# Each entry drives one josh-filter run and one force-push. Add projects in
# small batches and watch the first run of each: a filter that maps in a
# shared path makes the published repo pick up every commit touching that
# path, forever.
#
#   name    repo name on the knot, under `owner`
#   path    directory in the monorepo (documentation; the filter is what runs)
#   filter  josh filter expression, applied to the monorepo tip
#
# Filter conventions, decided in the pilot:
#
#   :/<path>                   take the subdirectory as the repo root
#   :[A,B]                     union: take A and B together.
#   :exclude[::*.nix]          drop every top-level nix file. default.nix is
#                              a flakelight module, meaningless outside the
#                              monorepo (the root flake imports it and it
#                              reaches for ../../nix/lib), and the testsuite
#                              helpers it calls are dead weight without it.
#                              A glob rather than a list: several projects
#                              carry more than two, and new ones appear.
#   ...::flake.nix             then add flake.nix back. That one IS meant to
#                              ship: it is the published repo's own build,
#                              generated by gen-standalone.nu. Excluding every
#                              nix file and re-adding one is easier to keep
#                              right than enumerating what to drop.
#   :unsign                    strip commit signatures. These are read-only
#                              mirrors, so a perfect reverse-filter is not
#                              worth publishing invalid signatures for.
#
# Optional per-project build settings, for the few that are not pure Rust:
#
#   nativeBuildInputs  build-time tools, e.g. ["pkg-config"]
#   buildInputs        libraries linked against, e.g. ["openssl" "dbus"]
#   doCheck            set false where the tests need network or a server
#
# Stated here rather than read out of default.nix, because telling that file's
# main package apart from the test fixtures beside it is guesswork: most of
# what those files declare belongs to a differential-testing derivation, not to
# the thing being published.
#
# An optional `deps` list names sibling projects whose directories must ship
# alongside, for a crate whose Cargo.toml has a path dependency on one
# (safety/oxidized/grep needs ../pcre2). Cargo resolves a path dependency on the
# filesystem, so no flake can supply it: the dependency has to be present, at
# that relative path. josh does this natively by prefixing each directory into
# the same layout it has here, which keeps `path = "../pcre2"` correct without
# editing a single Cargo.toml. Such a project publishes as several top-level
# directories, so its own crate is one level down and the flake builds it with
# buildAndTestSubdir.
#
# Keep the shared surface empty, with `deps` the single deliberate exception.
# Every path mapped into a published repo makes it pick up commits touching
# that path, so rust-grep sees safety/oxidized/pcre2's history and rust-pcre2 publishes
# that same history separately. That duplication is the price of a repo that
# builds standalone, and it is bounded: both dependency projects are leaves
# with no outward path dependencies of their own, so each closure is one level
# deep. Nothing else maps a path from outside its own directory.
# An optional post_ingest list runs after a contribution is reverse-filtered,
# in a temporary worktree checked out from the review branch. Anything it
# changes is committed onto that branch, so a contribution can be normalised
# (a formatter, a lockfile refresh) before you read it:
#
#   post_ingest: [{ cmd: ["cargo" "fmt"], message: "style: cargo fmt" }]
[
  {
    name: "oxidized-awk"
    path: "safety/oxidized/awk"
    filter: ":[:/rust/awk:exclude[::*.nix],:/rust/awk::flake.nix,:/safety/oxidized/awk:exclude[::*.nix],:/safety/oxidized/awk::flake.nix]:unsign"
  }
  {
    name: "oxidized-bash"
    path: "safety/oxidized/bash"
    filter: ":[:/rust/bash:exclude[::*.nix],:/rust/bash::flake.nix,:/safety/oxidized/bash:exclude[::*.nix],:/safety/oxidized/bash::flake.nix]:unsign"
  }
  {
    name: "oxidized-systemd"
    description: "A systemd-compatible service manager written in Rust"
    path: "safety/oxidized/systemd"
    # Tests are built but not run here, and this is a disk limit rather than
    # anything wrong with them: the Spindle microvm runs out of space while
    # linking the first test binary, after the release build of a systemd
    # reimplementation has already nearly filled it. Spindle exposes no way to
    # ask for a bigger disk, and the margin is gone before even one test
    # binary, so no subset fits either. Every other published repo runs its
    # tests; this is the largest project by a wide margin.
    #
    # Nothing is being hidden: cargo test passes 9659 and skips 4 anywhere
    # with the disk for it, and the monorepo's own CI is where the heavy
    # suite belongs.
    doCheck: false
    filter: ":[:/rust/systemd:exclude[::*.nix],:/rust/systemd::flake.nix,:/safety/oxidized/systemd:exclude[::*.nix],:/safety/oxidized/systemd::flake.nix]:unsign"
  }
  {
    name: "oxidized-perl"
    path: "safety/oxidized/perl"
    # Its FFI wrapper includes two headers that ship only in Perl's source
    # distribution, so build.rs is handed an unpacked tree to include from.
    env: {PERL_SRC: "${pkgs.srcOnly pkgs.perl}"}
    filter: ":[:/rust/perl:exclude[::*.nix],:/rust/perl::flake.nix,:/safety/oxidized/perl:exclude[::*.nix],:/safety/oxidized/perl::flake.nix]:unsign"
  }
  {
    name: "oxidized-make"
    path: "safety/oxidized/make"
    filter: ":[:/rust/make:exclude[::*.nix],:/rust/make::flake.nix,:/safety/oxidized/make:exclude[::*.nix],:/safety/oxidized/make::flake.nix]:unsign"
  }
  {
    name: "oxidized-sed"
    path: "safety/oxidized/sed"
    filter: ":[:/rust/sed:exclude[::*.nix],:/rust/sed::flake.nix,:/safety/oxidized/sed:exclude[::*.nix],:/safety/oxidized/sed::flake.nix]:unsign"
  }
  {
    name: "oxidized-tar"
    path: "safety/oxidized/tar"
    filter: ":[:/rust/tar:exclude[::*.nix],:/rust/tar::flake.nix,:/safety/oxidized/tar:exclude[::*.nix],:/safety/oxidized/tar::flake.nix]:unsign"
  }
  {
    name: "oxidized-binutils"
    description: "A GNU binutils-compatible suite of binary utilities written in Rust"
    path: "safety/oxidized/binutils"
    filter: ":[:/rust/binutils:exclude[::*.nix],:/rust/binutils::flake.nix,:/safety/oxidized/binutils:exclude[::*.nix],:/safety/oxidized/binutils::flake.nix]:unsign"
  }
  {
    name: "oxidized-pipewire"
    description: "A PipeWire-compatible multimedia graph daemon written in Rust"
    path: "safety/oxidized/pipewire"
    filter: ":[:/rust/pipewire:exclude[::*.nix],:/rust/pipewire::flake.nix,:/safety/oxidized/pipewire:exclude[::*.nix],:/safety/oxidized/pipewire::flake.nix]:unsign"
  }
  {
    name: "fe-c"
    description: "Gradual memory-safety hardening for unsafe Rust and mixed-language programs"
    path: "safety/fe-c"
    # A rustc compiler plugin: it links against rustc_middle, so it needs the
    # exact nightly named in its own rust-toolchain.toml, not nixpkgs' rustc.
    toolchain: true
    filter: ":[:/rust/fe-c:exclude[::*.nix],:/rust/fe-c::flake.nix,:/safety/fe-c:exclude[::*.nix],:/safety/fe-c::flake.nix]:unsign"
  }
  {
    name: "oxidized-flatpak"
    path: "safety/oxidized/flatpak"
    filter: ":[:/rust/flatpak:exclude[::*.nix],:/rust/flatpak::flake.nix,:/safety/oxidized/flatpak:exclude[::*.nix],:/safety/oxidized/flatpak::flake.nix]:unsign"
  }
  {
    name: "oxidized-ninja"
    path: "safety/oxidized/ninja"
    filter: ":[:/rust/ninja:exclude[::*.nix],:/rust/ninja::flake.nix,:/safety/oxidized/ninja:exclude[::*.nix],:/safety/oxidized/ninja::flake.nix]:unsign"
  }
  {
    name: "oxidized-meson"
    description: "A Meson-compatible build system written in Rust"
    path: "safety/oxidized/meson"
    filter: ":[:/rust/meson:exclude[::*.nix],:/rust/meson::flake.nix,:/safety/oxidized/meson:exclude[::*.nix],:/safety/oxidized/meson::flake.nix]:unsign"
  }
  {
    name: "oxidized-gzip"
    path: "safety/oxidized/gzip"
    filter: ":[:/rust/gzip:exclude[::*.nix],:/rust/gzip::flake.nix,:/safety/oxidized/gzip:exclude[::*.nix],:/safety/oxidized/gzip::flake.nix]:unsign"
  }
  {
    name: "oxidized-pcre2"
    description: "A PCRE2-compatible regular expression library written in Rust"
    path: "safety/oxidized/pcre2"
    filter: ":[:/rust/pcre2:exclude[::*.nix],:/rust/pcre2::flake.nix,:/safety/oxidized/pcre2:exclude[::*.nix],:/safety/oxidized/pcre2::flake.nix]:unsign"
  }
  {
    name: "oxidized-patch"
    path: "safety/oxidized/patch"
    filter: ":[:/rust/patch:exclude[::*.nix],:/rust/patch::flake.nix,:/safety/oxidized/patch:exclude[::*.nix],:/safety/oxidized/patch::flake.nix]:unsign"
  }
  {
    name: "oxidized-xz"
    path: "safety/oxidized/xz"
    filter: ":[:/rust/xz:exclude[::*.nix],:/rust/xz::flake.nix,:/safety/oxidized/xz:exclude[::*.nix],:/safety/oxidized/xz::flake.nix]:unsign"
  }
  {
    name: "oxidized-patchelf"
    path: "safety/oxidized/patchelf"
    filter: ":[:/rust/patchelf:exclude[::*.nix],:/rust/patchelf::flake.nix,:/safety/oxidized/patchelf:exclude[::*.nix],:/safety/oxidized/patchelf::flake.nix]:unsign"
  }
  {
    name: "oxidized-gcc"
    path: "safety/oxidized/gcc"
    # Its passes document themselves with IR diagrams written as indented
    # blocks, which rustdoc compiles as Rust, so three doctests fail to parse.
    # Fixing the fences is a two-line change to the crate, but the hooks lint
    # only what a change touches, and touching this one wakes 62 clippy errors
    # and 2652 deslop findings that predate it. Run the 493 real tests and
    # leave the doc examples until that debt is dealt with on its own.
    cargoTestFlags: ["--lib" "--bins"]
    filter: ":[:/rust/gcc:exclude[::*.nix],:/rust/gcc::flake.nix,:/safety/oxidized/gcc:exclude[::*.nix],:/safety/oxidized/gcc::flake.nix]:unsign"
  }
  {
    name: "oxidized-bison"
    path: "safety/oxidized/bison"
    description: "A POSIX yacc/bison-compatible parser generator written in Rust"
    filter: ":[:/rust/bison:exclude[::*.nix],:/rust/bison::flake.nix,:/safety/oxidized/bison:exclude[::*.nix],:/safety/oxidized/bison::flake.nix]:unsign"
  }
  {
    name: "oxidized-bubblewrap"
    path: "safety/oxidized/bubblewrap"
    description: "A bubblewrap-compatible unprivileged sandboxing tool written in Rust"
    filter: ":[:/rust/bubblewrap:exclude[::*.nix],:/rust/bubblewrap::flake.nix,:/safety/oxidized/bubblewrap:exclude[::*.nix],:/safety/oxidized/bubblewrap::flake.nix]:unsign"
  }
  {
    name: "oxidized-bzip2"
    path: "safety/oxidized/bzip2"
    description: "A bzip2-compatible compression tool written in Rust"
    filter: ":[:/rust/bzip2:exclude[::*.nix],:/rust/bzip2::flake.nix,:/safety/oxidized/bzip2:exclude[::*.nix],:/safety/oxidized/bzip2::flake.nix]:unsign"
  }
  {
    name: "oxidized-cachix"
    path: "safety/oxidized/cachix"
    description: "A Cachix-compatible CLI for Nix binary cache hosting written in Rust"
    filter: ":[:/rust/cachix:exclude[::*.nix],:/rust/cachix::flake.nix,:/safety/oxidized/cachix:exclude[::*.nix],:/safety/oxidized/cachix::flake.nix]:unsign"
  }
  {
    name: "oxidized-curl"
    path: "safety/oxidized/curl"
    description: "A curl-compatible HTTP client written in Rust"
    filter: ":[:/rust/curl:exclude[::*.nix],:/rust/curl::flake.nix,:/safety/oxidized/curl:exclude[::*.nix],:/safety/oxidized/curl::flake.nix]:unsign"
  }
  {
    name: "oxidized-diffutils"
    path: "safety/oxidized/diffutils"
    description: "A GNU diffutils-compatible suite of file comparison tools written in Rust"
    filter: ":[:/rust/diffutils:exclude[::*.nix],:/rust/diffutils::flake.nix,:/safety/oxidized/diffutils:exclude[::*.nix],:/safety/oxidized/diffutils::flake.nix]:unsign"
  }
  {
    name: "oxidized-direnv"
    path: "safety/oxidized/direnv"
    description: "A direnv-compatible environment loader written in Rust"
    filter: ":[:/rust/direnv:exclude[::*.nix],:/rust/direnv::flake.nix,:/safety/oxidized/direnv:exclude[::*.nix],:/safety/oxidized/direnv::flake.nix]:unsign"
  }
  {
    name: "oxidized-file"
    path: "safety/oxidized/file"
    description: "A GNU file-compatible file type detection tool written in Rust"
    filter: ":[:/rust/file:exclude[::*.nix],:/rust/file::flake.nix,:/safety/oxidized/file:exclude[::*.nix],:/safety/oxidized/file::flake.nix]:unsign"
  }
  {
    name: "oxidized-help2man"
    path: "safety/oxidized/help2man"
    description: "A GNU help2man-compatible man page generator written in Rust"
    filter: ":[:/rust/help2man:exclude[::*.nix],:/rust/help2man::flake.nix,:/safety/oxidized/help2man:exclude[::*.nix],:/safety/oxidized/help2man::flake.nix]:unsign"
  }
  {
    name: "oxidized-llvm"
    path: "safety/oxidized/llvm"
    description: "An LLVM-compatible compiler infrastructure written in Rust"
    filter: ":[:/rust/llvm:exclude[::*.nix],:/rust/llvm::flake.nix,:/safety/oxidized/llvm:exclude[::*.nix],:/safety/oxidized/llvm::flake.nix]:unsign"
  }
  {
    name: "oxidized-pkg-config"
    path: "safety/oxidized/pkg-config"
    description: "A pkg-config-compatible build metadata tool written in Rust"
    filter: ":[:/rust/pkg-config:exclude[::*.nix],:/rust/pkg-config::flake.nix,:/safety/oxidized/pkg-config:exclude[::*.nix],:/safety/oxidized/pkg-config::flake.nix]:unsign"
  }
  {
    name: "oxidized-texinfo"
    path: "safety/oxidized/texinfo"
    description: "A GNU makeinfo-compatible Texinfo processor written in Rust"
    filter: ":[:/rust/texinfo:exclude[::*.nix],:/rust/texinfo::flake.nix,:/safety/oxidized/texinfo:exclude[::*.nix],:/safety/oxidized/texinfo::flake.nix]:unsign"
  }
  {
    name: "wiki"
    path: "apps/wiki"
    description: "A political conference and discussion platform, in Rust and Dioxus"
    filter: ":[:/web/wiki:exclude[::*.nix],:/web/wiki::flake.nix,:/apps/wiki:exclude[::*.nix],:/apps/wiki::flake.nix]:unsign"
  }
  {
    name: "homepage"
    path: "apps/homepage"
    description: "The overby.me website, in Rust and Dioxus with WebGL screensavers"
    filter: ":[:/web/homepage:exclude[::*.nix],:/web/homepage::flake.nix,:/apps/homepage:exclude[::*.nix],:/apps/homepage::flake.nix]:unsign"
  }
  {
    name: "wclip"
    path: "dev/wclip"
    description: "An xclip-style Wayland clipboard tool written in Rust"
    filter: ":[:/rust/wclip:exclude[::*.nix],:/rust/wclip::flake.nix,:/safety/oxidized/wclip:exclude[::*.nix],:/safety/oxidized/wclip::flake.nix,:/dev/wclip:exclude[::*.nix],:/dev/wclip::flake.nix]:unsign"
  }
  # Not a rust/ rewrite: the flakelight module every other published repo
  # imports. It has to be published for them to resolve it, and it is
  # deliberately first in this list so a run that adds a project pushes the
  # module before anything that depends on it.
  {
    name: "nix-standalone"
    path: "platform/nix/standalone"
    filter: ":[:/nix/standalone,:/platform/nix/standalone]:unsign"
  }
  # Not a rust/ rewrite: the client this publisher itself uses to create and
  # authorise the repos it publishes to. Its path dependencies all point
  # inside crates/, so it needs no `deps`.
  {
    name: "tangled-cli"
    path: "platform/tangled/cli"
    nativeBuildInputs: ["pkg-config"]
    buildInputs: ["openssl" "dbus"]
    doCheck: false
    filter: ":[:/tangled/cli:exclude[::*.nix],:/tangled/cli::flake.nix,:/platform/tangled/cli:exclude[::*.nix],:/platform/tangled/cli::flake.nix]:unsign"
  }
  # The two multi-directory projects. Each dependency keeps its own name at
  # the root, because that is what the depending Cargo.toml already says.
  {
    name: "oxidized-grep"
    path: "safety/oxidized/grep"
    deps: ["safety/oxidized/pcre2"]
    filter: ":[:/rust/grep:exclude[::*.nix]:exclude[::flake.lock]:exclude[::.tangled/]:exclude[::README.md]:prefix=grep,:/rust/pcre2:exclude[::*.nix]:prefix=pcre2,:/rust/grep::flake.nix,:/rust/grep::flake.lock,:/rust/grep::README.md,:/rust/grep::.tangled/,:/safety/oxidized/grep:exclude[::*.nix]:exclude[::flake.lock]:exclude[::.tangled/]:exclude[::README.md]:prefix=grep,:/safety/oxidized/pcre2:exclude[::*.nix]:prefix=pcre2,:/safety/oxidized/grep::flake.nix,:/safety/oxidized/grep::flake.lock,:/safety/oxidized/grep::README.md,:/safety/oxidized/grep::.tangled/]:unsign"
  }
  {
    name: "h26xtoav1"
    path: "media/h26xtoav1"
    deps: ["media/h264-decoder" "media/h265-decoder"]
    filter: ":[:/rust/h26xtoav1:exclude[::*.nix]:exclude[::flake.lock]:exclude[::.tangled/]:exclude[::README.md]:prefix=h26xtoav1,:/rust/h264-decoder:exclude[::*.nix]:prefix=h264-decoder,:/rust/h265-decoder:exclude[::*.nix]:prefix=h265-decoder,:/rust/h26xtoav1::flake.nix,:/rust/h26xtoav1::flake.lock,:/rust/h26xtoav1::README.md,:/rust/h26xtoav1::.tangled/,:/media/h26xtoav1:exclude[::*.nix]:exclude[::flake.lock]:exclude[::.tangled/]:exclude[::README.md]:prefix=h26xtoav1,:/media/h264-decoder:exclude[::*.nix]:prefix=h264-decoder,:/media/h265-decoder:exclude[::*.nix]:prefix=h265-decoder,:/media/h26xtoav1::flake.nix,:/media/h26xtoav1::flake.lock,:/media/h26xtoav1::README.md,:/media/h26xtoav1::.tangled/]:unsign"
  }
]
