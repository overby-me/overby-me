# Given a directory holding a `build.ninja`, hand-written or generated by
# CMake/Meson/gn, extract its build graph with `oxidized-ninja -t graph-json`
# (one import-from-derivation) and lower each edge to its own derivation, in
# ./lower.nix. Sibling to ../../buck2/build/buildBuck2Project.nix.
#
# One derivation per build unit, here per Ninja edge, for the same reason as the
# cargo and buck2 libraries: every action caches independently, Nix schedules the
# DAG across cores and remote builders, and editing one source rebuilds only its
# edge and that edge's dependents. The fast incremental loop, made shareable.
{pkgs}: {
  # A directory that already contains `build.ninja` (pre-configured). Mutually
  # exclusive with `cmakeSource`.
  src ? null,
  # A CMake project directory to configure with `-G Ninja` first. It is placed
  # in the store, so the absolute source/`-I` paths CMake bakes into
  # `build.ninja` are store paths that Nix mounts automatically into every
  # edge's sandbox — no per-edge source staging needed.
  cmakeSource ? null,
  cmakeFlags ? [],
  # Extra tools, libraries and env for the CMake configure step only, not for
  # the per-edge builds: a real project needs python, bison, flex, pkg-config and
  # its dependencies' `.pc` files just to configure.
  configureNativeBuildInputs ? [],
  configureBuildInputs ? [],
  configureEnv ? {},
  # Rewrite CMake's absolute source refs to relative and stage individual files,
  # so editing one source rebuilds only its object. False instead mounts the whole
  # source tree read-only and keeps paths absolute: coarser, since any source edit
  # rebuilds the target's compiles, and right for single-target builds.
  perFileIncremental ? true,
  # A single target output path, or a list; defaults to the manifest's
  # `default` targets.
  target ? null,
  targets ? null,
  ninjaFile ? "build.ninja",
  # Per-component grouping: edgeIndex -> groupId. Set, edges lower one derivation
  # per group rather than per edge, running a group's internal edges in topological
  # order inside it: far fewer derivations, still input-isolated.
  grouping ? null,
  # Lower each group at build time via lower_group.py rather than during
  # evaluation, so eval computes only the group dependency graph.
  buildTimeLowering ? false,
  # Packages on PATH for every edge command. CMake bakes absolute tool paths, so
  # it needs little; a hand-written manifest calling `cc`/`ar` needs them here.
  toolchain ? [pkgs.stdenv.cc pkgs.coreutils],
  # The oxidized-ninja binary used for graph extraction. Built here by default so
  # the library is self-contained; override to reuse a cached package.
  rustNinja ? let
    # A path, because fileset takes paths: the input is an attribute set, and
    # `input + "/src"` on one is a string, which unions rejects.
    ninja = /. + (builtins.unsafeDiscardStringContext pkgs.inputs.oxidized-ninja.outPath);
  in
    pkgs.lib.buildCargoProject {
      pname = "rust-ninja";
      src = pkgs.lib.fileset.toSource {
        root = ninja;
        fileset = pkgs.lib.fileset.unions [
          (ninja + "/Cargo.toml")
          (ninja + "/Cargo.lock")
          (ninja + "/src")
        ];
      };
      index = ../../cargo/index;
      release = false;
    },
}: let
  inherit (pkgs) lib;
  inherit (builtins) length head;
  esc = lib.escapeShellArg;

  # ---- configure (CMake) -------------------------------------------------
  # The source goes into the store so the absolute paths CMake bakes into
  # build.ninja are store paths available in every edge's sandbox.
  cmakeSrcStore =
    if cmakeSource != null
    then
      builtins.path {
        path = cmakeSource;
        name = "cmake-src";
      }
    else null;

  configured = pkgs.runCommand "cmake-ninja-configured" ({
      nativeBuildInputs =
        [pkgs.cmake pkgs.ninja pkgs.stdenv.cc]
        ++ toolchain
        ++ configureNativeBuildInputs;
      buildInputs = configureBuildInputs;
    }
    // configureEnv) ''
    cmake -S ${cmakeSrcStore} -B $out -G Ninja ${lib.escapeShellArgs cmakeFlags}
  '';

  ninjaRoot =
    if cmakeSource != null
    then configured
    else if src != null
    then src
    else throw "buildNinjaProject: provide `src` or `cmakeSource`";

  # Per-file mode takes the source tree and the configured build dir as rewrite
  # roots and stages exactly what each compile reads, found by a `-M` scan with
  # both mounted, so an edit rebuilds one object and source-relative `#include`s
  # still resolve. Whole-source mode mounts both trees, leaves paths absolute, and
  # substitutes a content-addressed copy of the build dir for generated headers.
  rewriteRoots =
    if cmakeSource == null
    then []
    else if perFileIncremental
    then [cmakeSrcStore ninjaRoot]
    else [];

  scanMounts = lib.optionals (cmakeSource != null && perFileIncremental) [cmakeSrcStore ninjaRoot];

  # Content-addressed copy of the configured build dir, for the whole-source
  # mode's generated-header substitution (stable when only sources change).
  configuredCA =
    if cmakeSource != null && !perFileIncremental
    then
      builtins.path {
        path = configured;
        name = "cmake-configured";
      }
    else null;

  extraInputs = lib.optionals (cmakeSource != null && !perFileIncremental) [configuredCA cmakeSrcStore];
  subs = lib.optionals (cmakeSource != null && !perFileIncremental) [
    {
      from = toString ninjaRoot;
      to = toString configuredCA;
    }
  ];

  # ---- graph extraction (one IFD) ----------------------------------------
  # `-t graph-json` only parses the manifest and its includes, neither building
  # nor writing, so it runs read-only over the source store path. A concrete
  # target is passed through so only its subtree is emitted, which at CMake scale
  # is the difference between Darling's 38k edges and a launcher target's three.
  # Without one, everything must be dumped to discover `default`.
  targetArgs =
    if target != null
    then [target]
    else if targets != null
    then targets
    else [];
  graphDrv = pkgs.runCommand "ninja-graph-json" {} ''
    cd ${ninjaRoot}
    ${rustNinja}/bin/ninja -f ${esc ninjaFile} -t graph-json ${lib.escapeShellArgs targetArgs} > $out
  '';
  # The graph JSON names store paths, CMake having baked them into the commands,
  # and that context on every parsed string is illegal in derivation names and
  # other non-command positions. The paths edges really need come back through
  # `extraInputs` and `toolchain`.
  graph = builtins.fromJSON (builtins.unsafeDiscardStringContext (builtins.readFile graphDrv));

  # CMake's archive/link rules shell out to `cmake -E ...`, so edges need the
  # same cmake on PATH (its baked absolute path resolves once cmake is mounted).
  edgeToolchain = toolchain ++ lib.optional (cmakeSource != null) pkgs.cmake;

  lowered =
    (import ./lower.nix {
      inherit pkgs rewriteRoots extraInputs subs scanMounts graphDrv buildTimeLowering;
      src = ninjaRoot;
      toolchain = edgeToolchain;
    }).lowerGraph
    graph;

  # The grouped view of the same lowering, or null.
  groupedLowered =
    if grouping == null
    then null
    else lowered.lowerGroupsBy grouping;

  sanOut = s:
    "ninja-out-"
    + lib.strings.sanitizeDerivationName (builtins.unsafeDiscardStringContext s);

  # Copy the requested target out of its producing edge's tree. A phony aggregate
  # such as the top-level `all`, which `target = null` reaches through `default`,
  # has no file of its own, so every real target's declared outputs are staged
  # into one tree instead.
  buildOne = t:
    if lowered.isPhonyTarget t
    then
      pkgs.runCommand (sanOut t) {
        passthru = {
          inherit graphDrv;
          ninja = lowered;
          groupStats =
            if grouping != null
            then groupedLowered.groupStats
            else null;
        };
      } ''
        ${lib.concatMapStringsSep "\n" (o: ''
            mkdir -p "$out/$(dirname ${esc o.path})"
            cp -r --reflink=auto ${o.drv}/${esc o.path} "$out/${o.path}"
          '') (
            if grouping != null
            then groupedLowered.realOutputsForTargetG t
            else lowered.realOutputsForTarget t
          )}
      ''
    else let
      drv =
        if grouping != null
        then groupedLowered.groupDrvForOutput t
        else lowered.drvForOutput t;
    in
      pkgs.runCommand (sanOut t) {
        passthru = {
          producing = drv;
          inherit graphDrv;
          ninja = lowered;
        };
        meta.mainProgram = baseNameOf t;
      } ''
        mkdir -p "$out/$(dirname ${esc t})"
        cp -r --reflink=auto ${drv}/${esc t} "$out/${t}"
      '';

  chosen =
    if target != null
    then [target]
    else if targets != null
    then targets
    else graph.defaults;
in
  if chosen == []
  then throw "buildNinjaProject: no target given and the manifest has no `default`"
  else if length chosen == 1
  then buildOne (head chosen)
  else
    pkgs.symlinkJoin {
      name = "ninja-targets";
      paths = map buildOne chosen;
    }
