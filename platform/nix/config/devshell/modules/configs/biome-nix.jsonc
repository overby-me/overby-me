// Run `direnv reload` to apply changes to the repository.
{
	"$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
	"files": {
		"includes": [
			"**/*.js",
			"**/*.jsx",
			"**/*.ts",
			"**/*.tsx",
			"**/*.json",
			"**/*.css",
			"!.direnv",
			"!.devenv",
			".pre-commit-config.yaml",
			"!/nix/**/*",
			// web/wiki is a Rust/Dioxus/WASM app (it replaced the former React
			// app biome governed). Its incidental JS/CSS/JSON (service worker,
			// theme + test scripts, lexicon docs) are hand-authored to their own
			// conventions and were never biome-governed; keep them out of biome.
			"!/web/wiki/**/*",
			"!**/out",
			"!**/node_modules",
			"!**/dist",
			"!**/result",
			"!**/.next",
			"!**/schema.generated.ts"
		]
	},
	"linter": {
		"rules": {
			"a11y": {
				"useAnchorContent": "off",
				"useMediaCaption": "off"
			},
			"suspicious": {
				"noDuplicateFontNames": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "off"
			}
		}
	}
}
