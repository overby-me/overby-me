From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: overby.me <nix@overby.me>
Date: Tue, 30 Jun 2026 00:00:00 +0000
Subject: [PATCH] build(cmake): resolve desktop Qt/CEF/ICU from system on
 EO_USE_SYSTEM_LIBS

The BUILD_DESKTOP block previously only knew how to find the desktop ICU,
Qt and CEF inside the prebuilt Common/3dParty install dir (the pinned
ICU 60 / Qt 5.9.9 / CEF 5414 layout produced by build_3rdparty.py).

Add an EO_USE_SYSTEM_LIBS branch, mirroring the one already used for the
converter ICU/Boost/OpenSSL, so a packaging build can resolve:

  * desktop ICU  -> system ICU imported targets (ICU::uc/i18n/data);
  * Qt5          -> find_package(Qt5 ...) from the environment;
  * CEF          -> a CEF binary distribution pointed to by CEF_ROOT
                    (env or -D). On Apple we skip find_package(CEF): the
                    desktop-sdk links the framework directly with -F and
                    ships its own ABI-matched libcef_dll wrapper.

The legacy prebuilt path is preserved unchanged under the else() branch.
---
 common.cmake | 40 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/common.cmake b/common.cmake
index 6989d69..4ee90f3 100644
--- a/common.cmake
+++ b/common.cmake
@@ -156,6 +156,46 @@ else()
     endif()
 
     if(BUILD_DESKTOP)
+      if(EO_USE_SYSTEM_LIBS)
+        # System-libs desktop path (used by the Nix build). Resolve the desktop
+        # ICU, Qt and CEF from the environment instead of the prebuilt 3rd-party
+        # install dir. The desktop stack historically pinned ICU 60 / Qt 5.9.9 /
+        # CEF 5414, but desktop-apps' code is multi-version-aware (Qt 5.10..6,
+        # CEF >= 102); we target a single system Qt 5.15 + the matching CEF
+        # branch supplied via CEF_ROOT.
+
+        # Desktop ICU == system ICU (the converter ICU resolved below). Expose
+        # the same imported targets the desktop targets link against.
+        find_package(ICU REQUIRED COMPONENTS uc i18n data)
+        set(LIBICUUC_DESKTOP   ICU::uc)
+        set(LIBICUDATA_DESKTOP ICU::data)
+        set(LIBICUI_DESKTOP    ICU::i18n)
+        # Some desktop sources include <unicode/...> from this dir; point it at
+        # the system ICU include root.
+        get_filename_component(ICU_DESKTOP_INSTALL_DIR_ABS "${ICU_INCLUDE_DIR}/.." ABSOLUTE)
+
+        # Setup qt (system / nixpkgs). QT_VERSION_MAJOR drives the desktop code's
+        # Qt5/Qt6 branches; we pin 5 here.
+        set(QT_VERSION_MAJOR "5")
+        find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Core Gui Widgets PrintSupport Svg LinguistTools Multimedia MultimediaWidgets)
+
+        # Setup cef. CEF_ROOT must be provided (env or -D) and point at a CEF
+        # binary distribution layout (Release/ + cmake/ + include/). We do NOT
+        # call find_package(CEF) on Apple: the desktop-sdk links the framework
+        # directly via -F and supplies its own ABI-matched libcef_dll wrapper.
+        if(NOT CEF_ROOT)
+            if(DEFINED ENV{CEF_ROOT})
+                set(CEF_ROOT "$ENV{CEF_ROOT}")
+            endif()
+        endif()
+        if(NOT CEF_ROOT)
+            message(FATAL_ERROR "EO_USE_SYSTEM_LIBS + BUILD_DESKTOP requires CEF_ROOT to point at a CEF binary distribution.")
+        endif()
+        list(APPEND CMAKE_MODULE_PATH "${CEF_ROOT}/cmake")
+        if(NOT APPLE)
+            find_package(CEF REQUIRED)
+        endif()
+      else()
         # Setup icu desktop
         # These version numbers don't affect what build_3rdparty.py builds. They just have to match.
         set(ICU_DESKTOP_MAJOR_VER "60")
@@ -178,11 +218,12 @@ else()
         set(Qt5_DIR "${QT_ROOT}/lib/cmake/Qt5")
         set(QT_VERSION_MAJOR "5")
         find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Core Gui Widgets PrintSupport Svg LinguistTools Multimedia MultimediaWidgets)
-            
+
         # Setup cef
         set(CEF_ROOT "${EO_CORE_3RD_PARTY_INSTALL_DIR}/cef")
         list(APPEND CMAKE_MODULE_PATH "${CEF_ROOT}/cmake")
         find_package(CEF REQUIRED)
+      endif()
 
     endif()
 

