From 8deaf5926008d89cec125d5651affce30aeb11c6 Mon Sep 17 00:00:00 2001
From: Niclas Overby <niclas@overby.me>
Date: Mon, 29 Jun 2026 13:47:46 +0200
Subject: [PATCH 5/5] build(cmake): build doctrenderer with JavaScriptCore on
 macOS
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The document renderer has a macOS code path that uses JavaScriptCore instead of
V8, but it never built:

  * USE_JAVASCRIPT_CORE defaulted to 0 even on Apple; default it to 1 there
    (and default V8_USE_INSPECTOR to 0 when using JSC — the inspector is V8-only).
  * The .mm sources need Objective-C(++) enabled: enable_language(OBJC OBJCXX)
    on Apple.
  * The if(APPLE) target_compile_options() call was missing the visibility
    keyword (invalid arguments) and wrongly passed -framework as a compile
    option; pass only the ARC flags here and link Foundation + JavaScriptCore
    as frameworks instead.
  * V8 include dirs, V8_* defines and the V8 monolith are now gated behind
    NOT USE_JAVASCRIPT_CORE, so the macOS build needs no V8 at all.
---

diff --git a/DesktopEditor/doctrenderer/CMakeLists.txt b/DesktopEditor/doctrenderer/CMakeLists.txt
index 3ee99ff5d..bb142d7a3 100644
--- a/DesktopEditor/doctrenderer/CMakeLists.txt
+++ b/DesktopEditor/doctrenderer/CMakeLists.txt
@@ -6,17 +6,27 @@ set(CORE_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/../..")
 
 include(${CORE_ROOT_DIR}/common.cmake)
 
-# As far as I can tell, this should be set to 1 when building on mac.
+# On macOS the document renderer uses JavaScriptCore instead of V8.
+# (OBJC/OBJCXX are enabled at top-level project scope by common.cmake on Apple.)
 if(NOT DEFINED USE_JAVASCRIPT_CORE)
-    set(USE_JAVASCRIPT_CORE 0)
+    if(APPLE)
+        set(USE_JAVASCRIPT_CORE 1)
+    else()
+        set(USE_JAVASCRIPT_CORE 0)
+    endif()
 endif()
 
 if(NOT DEFINED DRAWINGFILE_SUPPORT)
     set(DRAWINGFILE_SUPPORT 1)
 endif()
 
+# The V8 inspector is meaningless without V8.
 if(NOT DEFINED V8_USE_INSPECTOR)
-    set(V8_USE_INSPECTOR 1)
+    if(USE_JAVASCRIPT_CORE)
+        set(V8_USE_INSPECTOR 0)
+    else()
+        set(V8_USE_INSPECTOR 1)
+    endif()
 endif()
 
 set(DESKTOP_EDITOR_ROOT "..")
@@ -216,10 +226,15 @@ target_include_directories(doctrenderer PRIVATE
     ${CMAKE_CURRENT_SOURCE_DIR}/addon
     ${CMAKE_CURRENT_SOURCE_DIR}/js_internal # js_base_embed.pri
     ${OPENSSL_INSTALL_DIR_ABS}/include
-    ${V8_INSTALL_DIR_ABS}/v8
-    ${V8_INSTALL_DIR_ABS}/v8/include
 )
 
+if(NOT USE_JAVASCRIPT_CORE)
+    target_include_directories(doctrenderer PRIVATE
+        ${V8_INSTALL_DIR_ABS}/v8
+        ${V8_INSTALL_DIR_ABS}/v8/include
+    )
+endif()
+
 if(V8_USE_INSPECTOR)
     target_include_directories(doctrenderer PRIVATE
         ${CMAKE_CURRENT_SOURCE_DIR}/js_internal/v8/inspector
@@ -232,11 +247,16 @@ target_compile_definitions(doctrenderer PRIVATE
     BUIDLER_OPEN_DOWNLOAD_ENABLED
     BUIDLER_OPEN_BASE64_ENABLED
     SUPPORT_HARFBUZZ_SHAPER # textshaper.pri
-    V8_VERSION_89_PLUS # v8.pri
-    V8_SUPPORT_SNAPSHOTS  # v8.pri
-    V8_COMPRESS_POINTERS # v8.pri
 )
 
+if(NOT USE_JAVASCRIPT_CORE)
+    target_compile_definitions(doctrenderer PRIVATE
+        V8_VERSION_89_PLUS # v8.pri
+        V8_SUPPORT_SNAPSHOTS  # v8.pri
+        V8_COMPRESS_POINTERS # v8.pri
+    )
+endif()
+
 if(USE_JAVASCRIPT_CORE)
     target_compile_definitions(doctrenderer PRIVATE
         JS_ENGINE_JAVASCRIPTCORE
@@ -262,9 +282,11 @@ if(DRAWINGFILE_SUPPORT)
 endif()
 
 if(APPLE)
-    target_compile_options(doctrenderer
-        $<$<COMPILE_LANGUAGE:OBJC>:-fobjc-arc -fobjc-weak -framework Foundation -framework JavaScriptCore>
-        $<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc -fobjc-weak -framework Foundation -framework JavaScriptCore>
+    # ObjC/ObjC++ sources (JavaScriptCore engine + embeds) need ARC; the
+    # frameworks are linked below.
+    target_compile_options(doctrenderer PRIVATE
+        $<$<COMPILE_LANGUAGE:OBJC>:-fobjc-arc -fobjc-weak>
+        $<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc -fobjc-weak>
     )
 endif()
 
@@ -278,9 +300,19 @@ target_link_libraries(doctrenderer INTERFACE
 target_link_libraries(doctrenderer PRIVATE
     ${OPENSSL_LIBSSL}
     ${OPENSSL_LIBCRYPTO}
-    ${V8_MONOLITH}
 )
 
+if(USE_JAVASCRIPT_CORE)
+    target_link_libraries(doctrenderer PRIVATE
+        "-framework Foundation"
+        "-framework JavaScriptCore"
+    )
+else()
+    target_link_libraries(doctrenderer PRIVATE
+        ${V8_MONOLITH}
+    )
+endif()
+
 target_link_libraries(doctrenderer PUBLIC
     graphics
     kernel
