From 2339535e01fdd2fb8b4c7f70d5dae318f2a14232 Mon Sep 17 00:00:00 2001
From: Niclas Overby <niclas@overby.me>
Date: Mon, 29 Jun 2026 13:01:27 +0200
Subject: [PATCH 2/5] build(cmake): build graphics with its macOS sources on
 Apple
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The graphics library never compiled its existing macOS support:

  * ApplicationFonts.cpp calls GetInstalledFontsMac() (under #ifdef _MAC),
    whose implementation lives in ApplicationFonts_mac.mm — a file the CMake
    source list never added, so the link failed with an undefined symbol.

Add ApplicationFonts_mac.mm to the graphics sources on APPLE, link the
Foundation + CoreText frameworks it uses, and exclude the Objective-C++ file
from the C++ precompiled header.
---
 DesktopEditor/graphics/cmake/CMakeLists.txt | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/DesktopEditor/graphics/cmake/CMakeLists.txt b/DesktopEditor/graphics/cmake/CMakeLists.txt
index 98ce1dfc7..9228070e8 100644
--- a/DesktopEditor/graphics/cmake/CMakeLists.txt
+++ b/DesktopEditor/graphics/cmake/CMakeLists.txt
@@ -628,6 +628,7 @@ add_library(graphics SHARED
 	${FONT_ENGINE_SOURCES_DIR}/fontconverter/FontFileType1C.cpp
 	${FONT_ENGINE_SOURCES_DIR}/fontconverter/Hash.cpp
     ${FONT_ENGINE_SOURCES_DIR}/ApplicationFonts.cpp
+    $<$<BOOL:${APPLE}>:${FONT_ENGINE_SOURCES_DIR}/ApplicationFonts_mac.mm>
     ${FONT_ENGINE_SOURCES_DIR}/ApplicationFontsWorker.cpp
     ${FONT_ENGINE_SOURCES_DIR}/fontconverter/StringExt.cpp
     ${FONT_ENGINE_SOURCES_DIR}/FontFile.cpp
@@ -1046,6 +1047,15 @@ target_precompile_headers(graphics PRIVATE
     ${CORE_ROOT_DIR}/msvc_fix.h
 )
 
+if(APPLE)
+    # The Objective-C++ sources can't share the C++ precompiled header
+    # (Objective-C is disabled in it).
+    set_source_files_properties(
+        ${FONT_ENGINE_SOURCES_DIR}/ApplicationFonts_mac.mm
+        PROPERTIES SKIP_PRECOMPILE_HEADERS ON
+    )
+endif()
+
 if(LINUX)
     target_compile_options(graphics PRIVATE
         -Wno-narrowing
@@ -1080,6 +1090,14 @@ if(WIN32)
     )
 endif()
 
+if(APPLE)
+    # ApplicationFonts_mac.mm enumerates installed fonts via CoreText.
+    target_link_libraries(graphics PUBLIC
+        "-framework Foundation"
+        "-framework CoreText"
+    )
+endif()
+
 copy_artifacts_to_folder("graphics" "${EO_CORE_OUTPUT_DIR}")
 
 declare_victory( graphics )
