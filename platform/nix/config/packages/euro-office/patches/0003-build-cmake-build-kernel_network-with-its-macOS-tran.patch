From ed9686817f9ccee41119a5976c6ef07ab1df097a Mon Sep 17 00:00:00 2001
From: Niclas Overby <niclas@overby.me>
Date: Mon, 29 Jun 2026 13:07:26 +0200
Subject: [PATCH 3/5] build(cmake): build kernel_network with its macOS
 transport on Apple

kernel_network never built its existing macOS support:

  * FileTransporter selected FileTransporter_curl.cpp for all non-Windows
    builds, but macOS ships FileTransporter_mac.mm (NSURLSession-based), which
    also provides CreateSession() (Session.cpp #ifdefs it out on _MAC). Without
    it the link failed with an undefined CreateSession symbol.

On APPLE, compile FileTransporter_mac.mm instead of the curl transport and link
Foundation + Cocoa. On other non-Windows platforms link system curl when
EO_USE_SYSTEM_LIBS is set (curl otherwise comes from the prebuilt 3rd-party
dir); EO_CURL_LIB is provided by common.cmake's find_package(CURL).
---
 Common/Network/CMakeLists.txt | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/Common/Network/CMakeLists.txt b/Common/Network/CMakeLists.txt
index e0f851794..51b436be4 100644
--- a/Common/Network/CMakeLists.txt
+++ b/Common/Network/CMakeLists.txt
@@ -59,6 +59,12 @@ if( MSVC )
     target_sources( kernel_network PRIVATE
         ${CMAKE_CURRENT_SOURCE_DIR}/FileTransporter/src/FileTransporter_win.cpp
     )
+elseif( APPLE )
+    # macOS uses the native NSURLSession-based transport (Foundation/Cocoa),
+    # which also provides CreateSession() (Session.cpp #ifdefs it out on _MAC).
+    target_sources( kernel_network PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}/FileTransporter/src/FileTransporter_mac.mm
+    )
 else()
     target_sources( kernel_network PRIVATE
         ${CMAKE_CURRENT_SOURCE_DIR}/FileTransporter/src/FileTransporter_curl.cpp
@@ -110,6 +116,21 @@ target_link_libraries(kernel_network PRIVATE
     ${OPENSSL_LIBCRYPTO}
 )
 
+# FileTransporter_curl.cpp (the non-Windows, non-Apple transport) uses libcurl.
+# With EO_USE_SYSTEM_LIBS this resolves to CURL::libcurl; otherwise it is empty
+# (curl comes from the 3rd-party dir).
+if( NOT MSVC AND NOT APPLE AND DEFINED EO_CURL_LIB )
+    target_link_libraries(kernel_network PRIVATE ${EO_CURL_LIB})
+endif()
+
+if( APPLE )
+    # FileTransporter_mac.mm uses NSURLSession.
+    target_link_libraries(kernel_network PRIVATE
+        "-framework Foundation"
+        "-framework Cocoa"
+    )
+endif()
+
 target_link_libraries(kernel_network PUBLIC
     kernel
 )
