+// Stub DoctRenderer / DocBuilder used when the library is built without a JS
+// engine (-DDISABLE_DOCT_RENDERER, i.e. neither V8 nor JavaScriptCore). The
+// JS-engine paths return a benign "engine unavailable" result so callers treat
+// them as errors, while the native, non-JS code keeps working.
+//
+// Consumers:
+//   * x2t links the converter and uses CDoctrenderer/CDocBuilder for the
+//     headless mail-merge / bin->PDF-HTML-image rendering / DocBuilder paths;
+//   * ascdocumentscore (desktop-sdk) additionally uses the full CDocBuilder /
+//     CDocBuilderValue / CDocBuilderContext scripting API for its headless
+//     form-field tools.
+//
+// This is the configuration used by the Linux desktop editor build: the
+// document is rendered by sdkjs running inside CEF (which embeds its own V8),
+// so these headless core paths are never exercised by the GUI.
+
+#include "doctrenderer.h"
+#include "docbuilder.h"
+
+namespace NSDoctRenderer
+{
+	// ---- CDoctrenderer -----------------------------------------------------
+	CDoctrenderer::CDoctrenderer(const std::wstring& /*sAllFontsPath*/)
+	{
+		m_pInternal = NULL;
+	}
+	CDoctrenderer::~CDoctrenderer() {}
+	void CDoctrenderer::LoadConfig(const std::wstring& /*sConfigDir*/, const std::wstring& /*sAllFontsPath*/) {}
+	bool CDoctrenderer::Execute(const std::wstring& /*strXml*/, std::wstring& strError)
+	{
+		// Callers detect failure by searching the result for "error".
+		strError = L"<result><error type=\"engine\" code=\"-1\">DoctRenderer JS engine is not available in this build</error></result>";
+		return false;
+	}
+	std::vector<std::wstring> CDoctrenderer::GetImagesInChanges()
+	{
+		return std::vector<std::wstring>();
+	}
+	void CDoctrenderer::CreateCache(const std::wstring& /*sAllFontsPath*/, const std::wstring& /*sCacheDir*/) {}
+	void CDoctrenderer::CreateSnapshots() {}
+	void CDoctrenderer::SetAdditionalParam(const AdditionalParamType& /*type*/, void* /*data*/) {}
+
+	// ---- CString -----------------------------------------------------------
+	CString::CString() { m_internal = NULL; }
+	CString::CString(const CString& /*src*/) { m_internal = NULL; }
+	CString& CString::operator=(const CString& /*src*/) { return *this; }
+	CString::~CString() {}
+	wchar_t* CString::c_str() const
+	{
+		static wchar_t empty[1] = {0};
+		return empty;
+	}
+
+	// ---- CDocBuilderValue --------------------------------------------------
+	CDocBuilderValue::CDocBuilderValue() { m_internal = NULL; }
+	CDocBuilderValue::CDocBuilderValue(const CDocBuilderValue& /*src*/) { m_internal = NULL; }
+	CDocBuilderValue& CDocBuilderValue::operator=(const CDocBuilderValue& /*src*/) { return *this; }
+	CDocBuilderValue::~CDocBuilderValue() {}
+	CDocBuilderValue::CDocBuilderValue(const char* /*value*/) { m_internal = NULL; }
+	CDocBuilderValue::CDocBuilderValue(const double& /*value*/) { m_internal = NULL; }
+	unsigned int CDocBuilderValue::GetLength() { return 0; }
+	CString CDocBuilderValue::ToString() { return CString(); }
+	CDocBuilderValue CDocBuilderValue::Get(const int& /*index*/) { return CDocBuilderValue(); }
+	CDocBuilderValue CDocBuilderValue::operator[](const char* /*name*/) { return CDocBuilderValue(); }
+	CDocBuilderValue CDocBuilderValue::Call(const char* /*name*/) { return CDocBuilderValue(); }
+	CDocBuilderValue CDocBuilderValue::Call(const char* /*name*/, CDocBuilderValue /*p1*/) { return CDocBuilderValue(); }
+
+	// ---- CDocBuilderContext ------------------------------------------------
+	CDocBuilderContext::CDocBuilderContext() { m_internal = NULL; }
+	CDocBuilderContext::CDocBuilderContext(const CDocBuilderContext& /*src*/) { m_internal = NULL; }
+	CDocBuilderContext& CDocBuilderContext::operator=(const CDocBuilderContext& /*src*/) { return *this; }
+	CDocBuilderContext::~CDocBuilderContext() {}
+	CDocBuilderValue CDocBuilderContext::GetGlobal() { return CDocBuilderValue(); }
+
+	// ---- CDocBuilder -------------------------------------------------------
+	CDocBuilder::CDocBuilder() { m_pInternal = NULL; }
+	CDocBuilder::~CDocBuilder() {}
+	int CDocBuilder::OpenFile(const wchar_t* /*path*/, const wchar_t* /*params*/) { return -1; }
+	int CDocBuilder::SaveFile(const int& /*type*/, const wchar_t* /*path*/, const wchar_t* /*params*/) { return -1; }
+	void CDocBuilder::CloseFile() {}
+	void CDocBuilder::SetProperty(const char* /*param*/, const wchar_t* /*value*/) {}
+	CDocBuilderContext CDocBuilder::GetContext(bool /*enterContext*/) { return CDocBuilderContext(); }
+	void CDocBuilder::Initialize(const wchar_t* /*directory*/) {}
+	void CDocBuilder::Dispose() {}
+}
