From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niclas Overby <niclas@overby.me>
Date: Tue, 30 Jun 2026 21:25:56 +0200
Subject: [PATCH] build(cmake): allow building doctrenderer without a JS engine

Add a DISABLE_DOCT_RENDERER option that builds a stub DoctRenderer/DocBuilder
(no V8, no JavaScriptCore). The JS-engine paths return a benign "engine
unavailable" result so callers treat them as errors, while the native, non-JS
conversions keep working.

This lets the Linux desktop editor build without V8: x2t links the stubbed
DoctRenderer/DocBuilder, and ascdocumentscore links the stubbed full DocBuilder
scripting API used by its headless form-field tools. The document is rendered
by sdkjs running inside CEF (which embeds its own V8), so core's headless
DoctRenderer is never exercised by the GUI. The format libraries
(graphics/kernel/PdfFile/...) are still built and re-exported PUBLIC.
---
 DesktopEditor/doctrenderer/CMakeLists.txt     |  57 ++++++++++
 .../doctrenderer/doctrenderer_stub.cpp        | 101 ++++++++++++++++++
 2 files changed, 158 insertions(+)
 create mode 100644 DesktopEditor/doctrenderer/doctrenderer_stub.cpp

diff --git a/DesktopEditor/doctrenderer/CMakeLists.txt b/DesktopEditor/doctrenderer/CMakeLists.txt
index bb142d7..3359ba4 100644
--- a/DesktopEditor/doctrenderer/CMakeLists.txt
+++ b/DesktopEditor/doctrenderer/CMakeLists.txt
@@ -66,6 +66,63 @@ if(DRAWINGFILE_SUPPORT)
     endif()
 endif()
 
+# Build without a JS engine (no V8, no JavaScriptCore). Compile a stub
+# DoctRenderer/DocBuilder so that x2t links and the native (non-JS) conversions
+# keep working, while the JS-engine paths (mail-merge, the DoctRenderer
+# bin->PDF/HTML/image rendering, and the DocBuilder scripting API) return an
+# "engine unavailable" error. This is the configuration used by the Linux
+# desktop build, where the editor renders via CEF's own V8 and these headless
+# core paths are unused. The format libraries (graphics/kernel/PdfFile/...) are
+# still added as subdirectories above and re-exported PUBLIC below.
+if(DISABLE_DOCT_RENDERER)
+    add_library(doctrenderer SHARED
+        ${CMAKE_CURRENT_SOURCE_DIR}/doctrenderer_stub.cpp
+
+        ${CMAKE_CURRENT_SOURCE_DIR}/docbuilder.h
+        ${CMAKE_CURRENT_SOURCE_DIR}/doctrenderer.h
+    )
+
+    set_default_options(doctrenderer)
+
+    # Export the stub's public symbols (BUILDER_DECL -> Q_DECL_EXPORT) so x2t,
+    # which imports them, links against this library under -fvisibility=hidden.
+    target_compile_definitions(doctrenderer PRIVATE
+        DOCTRENDERER_USE_DYNAMIC_LIBRARY_BUILDING
+        JSBASE_USE_DYNAMIC_LIBRARY_BUILDING
+    )
+
+    target_include_directories(doctrenderer PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}
+    )
+
+    target_link_libraries(doctrenderer PUBLIC
+        graphics
+        kernel
+        UnicodeConverter
+        kernel_network
+    )
+
+    if(DRAWINGFILE_SUPPORT)
+        target_link_libraries(doctrenderer PUBLIC
+            PdfFile
+            XpsFile
+            DjVuFile
+            DocxRenderer
+        )
+    endif()
+
+    if(UNIX)
+        target_link_libraries(doctrenderer PUBLIC
+            pthread
+        )
+    endif()
+
+    copy_artifacts_to_folder("doctrenderer" "${EO_CORE_OUTPUT_DIR}")
+
+    declare_victory( doctrenderer )
+    return()
+endif()
+
 add_library(doctrenderer SHARED
     ${CMAKE_CURRENT_SOURCE_DIR}/docbuilder_p.cpp
     ${CMAKE_CURRENT_SOURCE_DIR}/docbuilder.cpp
diff --git a/DesktopEditor/doctrenderer/doctrenderer_stub.cpp b/DesktopEditor/doctrenderer/doctrenderer_stub.cpp
new file mode 100644
index 0000000..35a0336
--- /dev/null
+++ b/DesktopEditor/doctrenderer/doctrenderer_stub.cpp
@@ -0,0 +1,101 @@
