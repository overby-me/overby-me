#!/usr/bin/env nu
source ./libtest-nix.nu

setup_repo

let active = $env.FL_DIR | path join app org.test.Hello $env.ARCH stable active

# Verify the app is installed and has a files directory
assert_has_dir ($active | path join files)
ok "app installed with files/"

# Delete the metadata file to simulate corruption
rm -f ($active | path join metadata)
assert_not_has_file ($active | path join metadata)
ok "metadata deleted (simulated corruption)"

# Run repair: it should detect and regenerate the missing metadata
let r = (do { ^$env.FLATPAK --user repair } | complete)
let output = $r.stdout + $r.stderr
print $"repair output: ($output)"

if ($output | lines | any {|l| $l =~ 'broken.*metadata|repaired.*metadata|Repaired' }) {
  ok "repair detected missing metadata"
} else {
  print "FAIL: repair did not detect missing metadata"
  print $"Got: ($output)"
  exit 1
}

# Verify metadata was regenerated
assert_has_file ($active | path join metadata)
ok "metadata regenerated by repair"

# Verify the app still appears in list
let lr = (do { ^$env.FLATPAK --user list } | complete)
let list_output = $lr.stdout + $lr.stderr
if ($list_output | lines | any {|l| $l =~ 'org.test.Hello' }) {
  ok "app still listed after repair"
} else {
  print "FAIL: app not listed after repair"
  print $"Got: ($list_output)"
  exit 1
}

print "PASS: vm-repair-missing-file"
