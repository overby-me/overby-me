From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: overby.me <nix@overby.me>
Date: Tue, 30 Jun 2026 00:00:00 +0000
Subject: [PATCH] cmake: set CORE_ROOT_DIR before including common.cmake in
 qt_wrapper

qt_wrapper/CMakeLists.txt included common.cmake using ${CORE_ROOT_DIR}
before that variable was set a few lines later. When qt_wrapper is the
top-level project, CORE_ROOT_DIR was empty at include time, so the
BUILD_DESKTOP block in common.cmake never ran and QT_VERSION_MAJOR was
left undefined. Downstream find_package(Qt${QT_VERSION_MAJOR} ...) calls
then degraded to find_package(Qt ...) and failed.

Move the CORE_ROOT_DIR / PWD_ROOT_DIR definitions above the include
(guarding CORE_ROOT_DIR so a parent project can still override it).
---
 ChromiumBasedEditors/lib/qt_wrapper/CMakeLists.txt | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/ChromiumBasedEditors/lib/qt_wrapper/CMakeLists.txt b/ChromiumBasedEditors/lib/qt_wrapper/CMakeLists.txt
--- a/ChromiumBasedEditors/lib/qt_wrapper/CMakeLists.txt
+++ b/ChromiumBasedEditors/lib/qt_wrapper/CMakeLists.txt
@@ -9,14 +9,14 @@ set(CMAKE_AUTORCC ON)
 
 #add_compile_options(-march=native)
 
-include(${CORE_ROOT_DIR}/common.cmake)
-
-
-
-# Paths
-set(CORE_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/../../../../core")
+# Paths (must be set before including common.cmake, which uses CORE_ROOT_DIR).
+if(NOT CORE_ROOT_DIR)
+    set(CORE_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/../../../../core")
+endif()
 set(PWD_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}")
 
+include(${CORE_ROOT_DIR}/common.cmake)
+
 # --- Subdirectories ---
 # Checks if targets exist to allow this to be included in larger builds
 if(NOT TARGET kernel)

