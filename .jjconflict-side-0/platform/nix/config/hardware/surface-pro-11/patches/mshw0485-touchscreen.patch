+ */
+static bool g6ts_parity_heat_input;
+module_param_named(parity_heat_input, g6ts_parity_heat_input, bool, 0444);
+MODULE_PARM_DESC(parity_heat_input,
+		 "Admit Heat/input only after complete Windows init+CFU parity");
