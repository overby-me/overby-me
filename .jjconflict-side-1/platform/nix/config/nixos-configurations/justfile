build host:
    nixos-rebuild build --flake .#{{ host }} --print-build-logs

switch host:
    sudo nixos-rebuild switch --flake .#{{ host }} --print-build-logs --keep-going

deploy host:
    colmena apply --on {{ host }} --verbose --impure

deploy-build-on-target host:
    colmena apply --on {{ host }} --build-on-target --verbose --impure

deploy-all:
    colmena apply --verbose --impure

rekey:
    cd ../secrets && agenix --rekey

# Mobile device image building and flashing

# The flake root is two levels up from platform/nix/config/nixos, not one. With a single ".."
# this landed on platform/nix/config/, where `getFlake "path:..."` finds no flake.nix.
[private]
_flake_dir := justfile_directory() / ".." / ".."

decrypt-hostkey device:
    mkdir -p /tmp/{{ device }}-hostkeys
    rage -d -i ~/.ssh/id_ed25519 ../secrets/{{ device }}-host-key.age -o /tmp/{{ device }}-hostkeys/ssh_host_ed25519_key
    chmod 600 /tmp/{{ device }}-hostkeys/ssh_host_ed25519_key
    ssh-keygen -y -f /tmp/{{ device }}-hostkeys/ssh_host_ed25519_key > /tmp/{{ device }}-hostkeys/ssh_host_ed25519_key.pub

build-boot device:
    nix build --impure --print-build-logs -o result-{{ device }}-boot --expr 'let flake = builtins.getFlake "path:{{ _flake_dir }}"; nixosConfig = flake.nixosConfigurations.{{ device }}; in flake.lib.mkBootImage { dtb = "qcom/qcm6490-fairphone-fp5.dtb"; } nixosConfig nixosConfig.pkgs'

build-rootfs device: (decrypt-hostkey device)
    nix build --impure --print-build-logs -o result-{{ device }}-rootfs --expr 'let flake = builtins.getFlake "path:{{ _flake_dir }}"; nixosConfig = flake.nixosConfigurations.{{ device }}; in flake.lib.mkRootfsImage nixosConfig nixosConfig.pkgs { sshHostKeyDir = /tmp/{{ device }}-hostkeys; }'

flash device: (build-boot device) (build-rootfs device)
    fastboot flash boot result-{{ device }}-boot
    fastboot flash userdata result-{{ device }}-rootfs
    fastboot reboot

# armitas (Surface Pro 11) installation

# Bootable installer for armitas. The build host needs
# `boot.binfmt.emulatedSystems = ["aarch64-linux"]`; write the result with
# `dd if=result-armitas-iso/iso/*.iso of=/dev/sdX bs=4M`.
build-iso:
    cd {{ _flake_dir }} && nix build --print-build-logs -o result-armitas-iso \
      .#nixosConfigurations.armitas-installer.config.system.build.isoImage

# Install armitas onto a Surface Pro 11 already booted into the installer
# ISO, reachable at `target` (an IP or hostname). Partitions and formats per
# the disko layout in nixos/config/armitas.nix, builds here rather than on
# the tablet, and copies the closure over SSH.
#
# The kexec phase is skipped explicitly: nixos-anywhere only needs it to get
# a machine that is not already running the installer into one, and its
# generic kexec tarball knows nothing about this hardware's devicetree.
#
# DESTRUCTIVE: wipes /dev/nvme0n1 on the target without prompting.
install-armitas target:
    cd {{ _flake_dir }} && nix run github:nix-community/nixos-anywhere -- \
      --flake .#armitas --phases disko,install,reboot \
      --print-build-logs root@{{ target }}
