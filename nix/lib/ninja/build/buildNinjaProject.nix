# buildNinjaProject: given a directory containing a `build.ninja` (hand-written
# or generated by CMake/Meson/gn), extract its build graph with `rust-ninja -t
# graph-json` (one import-from-derivation) and lower each edge to its own Nix
# derivation (see ./lower.nix). A sibling to nix/lib/buck2's buildBuck2Project.
#
# The value is the same as the cargo/buck2 libraries': one derivation per build
# unit (here, per Ninja edge) so that every action is cached independently in
# the Nix store, Nix schedules the DAG across cores/remote builders, and editing
# one source rebuilds only its edge and that edge's dependents — the fast
# incremental loop, but content-addressed and shareable.
{pkgs}: {
  # A directory that already contains `build.ninja` (pre-configured). Mutually
  # exclusive with `cmakeSource`.
  src ? null,
  # A CMake project directory to configure with `-G Ninja` first. It is placed
  # in the store, so the absolute source/`-I` paths CMake bakes into
  # `build.ninja` are store paths that Nix mounts automatically into every
  # edge's sandbox — no per-edge source staging needed.
  cmakeSource ? null,
  cmakeFlags ? [],
  # Extra tools/libraries/env for the CMake configure step (a real project may
  # need python, bison, flex, pkg-config, and its dependency `.pc`s to
  # configure). These affect only configure, not the per-edge builds.
  configureNativeBuildInputs ? [],
  configureBuildInputs ? [],
  configureEnv ? {},
  # Per-file incremental compiles (default): rewrite CMake's absolute source
  # refs to relative and stage individual files, so editing one source rebuilds
  # only its object. Set false to instead mount the whole source tree read-only
  # and keep absolute paths — coarser (any source edit rebuilds the target's
  # compiles) but correct for sources that use source-relative includes
  # (`#include "../x.h"`) which `-I` staging cannot see. Right for single-target
  # builds; the general fix is depfile-precise staging (see PLAN.md M4).
  perFileIncremental ? true,
  # A single target output path, or a list; defaults to the manifest's
  # `default` targets.
  target ? null,
  targets ? null,
  ninjaFile ? "build.ninja",
  # Packages on PATH for every edge command (CMake bakes absolute tool paths;
  # hand-written manifests calling `cc`/`ar`/... need a toolchain here).
  toolchain ? [pkgs.stdenv.cc pkgs.coreutils],
  # The rust-ninja binary used for graph extraction. Built here by default so
  # the library is self-contained; override to reuse a cached package.
  rustNinja ?
    pkgs.lib.buildCargoProject {
      pname = "rust-ninja";
      src = pkgs.lib.fileset.toSource {
        root = ../../../../rust/ninja;
        fileset = pkgs.lib.fileset.unions [
          ../../../../rust/ninja/Cargo.toml
          ../../../../rust/ninja/Cargo.lock
          ../../../../rust/ninja/src
        ];
      };
      index = ../../cargo/index;
      release = false;
    },
}: let
  inherit (pkgs) lib;
  inherit (builtins) length head;
  esc = lib.escapeShellArg;

  # ---- configure (CMake) -------------------------------------------------
  # The source goes into the store so the absolute paths CMake bakes into
  # build.ninja are store paths available in every edge's sandbox.
  cmakeSrcStore =
    if cmakeSource != null
    then
      builtins.path {
        path = cmakeSource;
        name = "cmake-src";
      }
    else null;

  configured = pkgs.runCommand "cmake-ninja-configured" ({
      nativeBuildInputs =
        [pkgs.cmake pkgs.ninja pkgs.stdenv.cc]
        ++ toolchain
        ++ configureNativeBuildInputs;
      buildInputs = configureBuildInputs;
    }
    // configureEnv) ''
    cmake -S ${cmakeSrcStore} -B $out -G Ninja ${lib.escapeShellArgs cmakeFlags}
  '';

  ninjaRoot =
    if cmakeSource != null
    then configured
    else if src != null
    then src
    else throw "buildNinjaProject: provide `src` or `cmakeSource`";

  # Depfile-precise per-file mode (default): treat the source tree and the
  # configured build dir as rewrite roots, and stage exactly the files each
  # compile reads (discovered by a `-M` scan over both trees mounted) — so
  # editing one source rebuilds only its object and source-relative `#include`s
  # resolve. Whole-source mode instead mounts both trees, leaves paths absolute,
  # and substitutes the build dir with a content-addressed copy for generated
  # headers (coarser; used for single-target builds — see `perFileIncremental`).
  rewriteRoots =
    if cmakeSource == null
    then []
    else if perFileIncremental
    then [cmakeSrcStore ninjaRoot]
    else [];

  scanMounts = lib.optionals (cmakeSource != null && perFileIncremental) [cmakeSrcStore ninjaRoot];

  # Content-addressed copy of the configured build dir, for the whole-source
  # mode's generated-header substitution (stable when only sources change).
  configuredCA =
    if cmakeSource != null && !perFileIncremental
    then
      builtins.path {
        path = configured;
        name = "cmake-configured";
      }
    else null;

  extraInputs = lib.optionals (cmakeSource != null && !perFileIncremental) [configuredCA cmakeSrcStore];
  subs = lib.optionals (cmakeSource != null && !perFileIncremental) [
    {
      from = toString ninjaRoot;
      to = toString configuredCA;
    }
  ];

  # ---- graph extraction (one IFD) ----------------------------------------
  # `-t graph-json` only parses the manifest (+ subninja/include); it neither
  # builds nor writes, so it runs read-only over the source store path. When a
  # concrete target is requested we pass it through so only that target's
  # subtree is emitted — essential at CMake scale (Darling is ~38k edges; one
  # launcher target is ~3), keeping the JSON and the lowered derivation count
  # tiny. Without a target we must dump everything to discover `default`.
  targetArgs =
    if target != null
    then [target]
    else if targets != null
    then targets
    else [];
  graphDrv = pkgs.runCommand "ninja-graph-json" {} ''
    cd ${ninjaRoot}
    ${rustNinja}/bin/ninja -f ${esc ninjaFile} -t graph-json ${lib.escapeShellArgs targetArgs} > $out
  '';
  # Discard the readFile string context: the graph JSON mentions store paths
  # (CMake bakes source/compiler store paths into commands) and that context,
  # applied to every parsed string, is illegal in derivation names and other
  # non-command positions. The store paths edges actually need are re-provided
  # via `extraInputs` (configured dir + source) and `toolchain` (compiler).
  graph = builtins.fromJSON (builtins.unsafeDiscardStringContext (builtins.readFile graphDrv));

  # CMake's archive/link rules shell out to `cmake -E ...`, so edges need the
  # same cmake on PATH (its baked absolute path resolves once cmake is mounted).
  edgeToolchain = toolchain ++ lib.optional (cmakeSource != null) pkgs.cmake;

  lowered =
    (import ./lower.nix {
      inherit pkgs rewriteRoots extraInputs subs scanMounts;
      src = ninjaRoot;
      toolchain = edgeToolchain;
    }).lowerGraph
    graph;

  sanOut = s:
    "ninja-out-"
    + lib.strings.sanitizeDerivationName (builtins.unsafeDiscardStringContext s);

  # Copy just the requested target out of its producing edge's tree.
  buildOne = t: let
    drv = lowered.drvForOutput t;
  in
    pkgs.runCommand (sanOut t) {
      passthru = {
        producing = drv;
        inherit graphDrv;
        ninja = lowered;
      };
      meta.mainProgram = baseNameOf t;
    } ''
      mkdir -p "$out/$(dirname ${esc t})"
      cp -r --reflink=auto ${drv}/${esc t} "$out/${t}"
    '';

  chosen =
    if target != null
    then [target]
    else if targets != null
    then targets
    else graph.defaults;
in
  if chosen == []
  then throw "buildNinjaProject: no target given and the manifest has no `default`"
  else if length chosen == 1
  then buildOne (head chosen)
  else
    pkgs.symlinkJoin {
      name = "ninja-targets";
      paths = map buildOne chosen;
    }
